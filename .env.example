# Desktop build trust anchors (public values only)
DOKKOMPLEKT_LICENSE_PUBKEY_B64=
DOKKOMPLEKT_UPDATE_PUBKEY_B64=
DOKKOMPLEKT_UPDATE_MANIFEST_URL=https://updates.example.com/dokkomplekt/update-manifest.json
DOKKOMPLEKT_COMPONENTS_CATALOG_URL=https://updates.example.com/dokkomplekt/components-catalog.json
DOKKOMPLEKT_REFDATA_URL=https://updates.example.com/dokkomplekt/reference-data/production-calendar-ru.json
DOKKOMPLEKT_REFDATA_PUBKEY_B64=

# Optional multi-machine queue. Desktop remains offline-first and does not
# receive PostgreSQL credentials. Configure these only on workstations that
# explicitly participate in a central mTLS queue.
DOKKOMPLEKT_QUEUE_MTLS_URL=https://queue.example.internal:9443
DOKKOMPLEKT_QUEUE_MTLS_CA_PEM=C:\ProgramData\Dokkomplekt\queue-ca.pem
DOKKOMPLEKT_QUEUE_MTLS_IDENTITY_PEM=C:\ProgramData\Dokkomplekt\queue-client-combined.pem

# Queue-server secret (server only; never copy to desktop .env files).
# Prefer a protected DSN file or an environment secret consumed by
# scripts/queue_mtls_service.py. PostgreSQL mode requires sslmode=verify-full
# (or verify-ca) and sslrootcert; optional sslcert+sslkey enable DB-side mTLS.
DOKKOMPLEKT_QUEUE_POSTGRES_DSN=

# License server secrets — never commit real values. This Rust server currently
# permits NoTls only over a local Unix-domain socket in production; remote DB
# hosts fail before connection. Keep PostgreSQL co-located or add an audited TLS connector.
DOKKOMPLEKT_ENV=production
DATABASE_URL=postgresql:///dokkomplekt?host=/var/run/postgresql
DOKKOMPLEKT_LICENSE_ISSUER_KEY_B64=
DOKKOMPLEKT_LICENSE_ISSUE_SECRET=
DOKKOMPLEKT_PROVIDER_CALLBACK_SECRET=
DOKKOMPLEKT_PAYMENT_PROVIDER=yookassa
DOKKOMPLEKT_YOOKASSA_SHOP_ID=
DOKKOMPLEKT_YOOKASSA_SECRET_KEY=

# Release signing machine only; never embed or commit this private seed
DOKKOMPLEKT_UPDATE_PRIVATE_KEY_B64=
