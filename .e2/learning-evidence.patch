+import { describe, expect, it } from 'vitest';
+import type { TemplateLearningReport } from './types';
+import { validatedLearningFields } from './pendingTemplateIntelligence';
+
+function report(passed: boolean, matchedFields: string[]): TemplateLearningReport {
+  return {
+    fields: [
+      { field_id: 'employee.name', confidence: 0.99 },
+      { field_id: 'employee.position', confidence: 0.99 },
+    ],
+    validation: {
+      passed,
+      matched_fields: matchedFields,
+      training_pairs: 3,
+      held_out_pairs: 1,
+      interventions_checked: passed ? 1 : 0,
+      mismatched_fields: [],
+      reasons: passed ? [] : ['proof missing'],
+    },
+  } as unknown as TemplateLearningReport;
+}
+
+describe('validatedLearningFields', () => {
+  it('never treats high confidence as proof when held-out validation failed', () => {
+    const fields = validatedLearningFields(report(false, ['employee.name', 'employee.position']));
+    expect(fields).toEqual([]);
+  });
+
+  it('offers only fields explicitly confirmed by held-out source evidence', () => {
+    const fields = validatedLearningFields(report(true, ['employee.name']));
+    expect(fields.map((field) => field.field_id)).toEqual(['employee.name']);
+  });
+});
