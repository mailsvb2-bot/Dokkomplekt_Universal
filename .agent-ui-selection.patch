+/**
+ * Preserve the legacy safe default for medical packs without making the
+ * profession-neutral UI depend on a translated button label. Discharge and
+ * diary documents are deliberate actions, while all other configured
+ * documents keep the existing default-on behavior.
+ */
+export function shouldSelectDocumentByDefault(document: DocumentTemplateSpec): boolean {
+  if (document.category !== 'Medical') return true;
+  const role = document.role_id.trim().toLowerCase();
+  return !(
+    role === 'discharge'
+    || role.endsWith('.discharge')
+    || role === 'diary'
+    || role === 'diaries'
+    || role.endsWith('.diary')
+    || role.endsWith('.diaries')
+  );
+}
