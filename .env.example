# Desktop build trust anchors (public values only)
DOKKOMPLEKT_GATE_PUBKEY_B64=
DOKKOMPLEKT_LICENSE_PUBKEY_B64=
DOKKOMPLEKT_UPDATE_PUBKEY_B64=
DOKKOMPLEKT_THRESHOLD_PUBKEY_B64=
# Required for a production build. Leave blank until real public HTTPS endpoints
# are configured in repository variables; reserved example domains are rejected.
DOKKOMPLEKT_UPDATE_MANIFEST_URL=
DOKKOMPLEKT_COMPONENTS_CATALOG_URL=
DOKKOMPLEKT_COMPONENTS_BASE_URL=
DOKKOMPLEKT_REFDATA_URL=
DOKKOMPLEKT_REFDATA_PUBKEY_B64=

# Ephemeral GitHub-hosted Windows signing/runtime source. These remain blank in
# source control. Production environments point them at immutable public HTTPS
# objects for one independently approved signed runtime payload.
DOKKOMPLEKT_RUNTIME_BUNDLE_URL=
DOKKOMPLEKT_RUNTIME_BUNDLE_PAYLOAD_URL=
DOKKOMPLEKT_RUNTIME_BUNDLE_SIGNATURE_URL=
DOKKOMPLEKT_RUNTIME_BUNDLE_APPROVAL_SIGNATURE_URL=
DOKKOMPLEKT_RUNTIME_TRUSTED_PUBKEY_PEM_B64=
DOKKOMPLEKT_RUNTIME_LOCK_APPROVAL_PUBKEY_PEM_B64=

# Optional multi-machine queue. Desktop remains offline-first and does not
# receive PostgreSQL credentials. Configure these only on workstations that
# explicitly participate in a central mTLS queue.
# Optional. Leave blank unless a real mTLS queue endpoint has been provisioned.
DOKKOMPLEKT_QUEUE_MTLS_URL=
DOKKOMPLEKT_QUEUE_MTLS_CA_PEM=C:\ProgramData\Dokkomplekt\queue-ca.pem
DOKKOMPLEKT_QUEUE_MTLS_IDENTITY_PEM=C:\ProgramData\Dokkomplekt\queue-client-combined.pem

# Queue-server secret (server only; never copy to desktop .env files).
# Prefer a protected DSN file or an environment secret consumed by
# scripts/queue_mtls_service.py. PostgreSQL mode requires sslmode=verify-full
# (or verify-ca) and sslrootcert; optional sslcert+sslkey enable DB-side mTLS.
DOKKOMPLEKT_QUEUE_POSTGRES_DSN=

# License server is fail-closed by default. Insecure local development requires both
# DOKKOMPLEKT_ENV=development and DOKKOMPLEKT_ALLOW_INSECURE_DEV=1. Never set the
# opt-in on a deployed server.
# License server secrets — never commit real values. This Rust server currently
# permits NoTls only over a local Unix-domain socket in production; remote DB
# hosts fail before connection. Keep PostgreSQL co-located or add an audited TLS connector.
DOKKOMPLEKT_ENV=production
# Required on a deployed production server. A blank value fails closed until a
# real public HTTPS origin is supplied.
DOKKOMPLEKT_LICENSE_PUBLIC_URL=
DATABASE_URL=postgresql:///dokkomplekt?host=/var/run/postgresql
DOKKOMPLEKT_LICENSE_ISSUER_KEY_B64=
DOKKOMPLEKT_LICENSE_ISSUE_SECRET=
# Separate administrative secret used only to recover access for pre-token legacy orders.
DOKKOMPLEKT_ORDER_RECOVERY_SECRET=
DOKKOMPLEKT_PROVIDER_CALLBACK_SECRET=
DOKKOMPLEKT_PAYMENT_PROVIDER=yookassa
DOKKOMPLEKT_YOOKASSA_SHOP_ID=
DOKKOMPLEKT_YOOKASSA_SECRET_KEY=
# Production is pinned to https://api.yookassa.ru. Development overrides are
# accepted only for localhost/loopback mock servers.
DOKKOMPLEKT_YOOKASSA_API_BASE_URL=https://api.yookassa.ru
# Bounded server resources and per-client request budgets.
DOKKOMPLEKT_GLOBAL_CONCURRENCY_LIMIT=128
DOKKOMPLEKT_PROVIDER_CONCURRENCY_LIMIT=8
DOKKOMPLEKT_REQUEST_TIMEOUT_SECONDS=30
DOKKOMPLEKT_ORDER_CREATE_LIMIT_PER_HOUR=20
DOKKOMPLEKT_ORDER_ACCESS_LIMIT_PER_MINUTE=120
DOKKOMPLEKT_PROVIDER_CALLBACK_LIMIT_PER_MINUTE=120
DOKKOMPLEKT_ORDER_RECOVERY_LIMIT_PER_MINUTE=30
# Trust forwarded client addresses only from explicitly listed reverse proxies.
# Example for a local nginx/Traefik proxy: 127.0.0.1/32,::1/128
DOKKOMPLEKT_TRUSTED_PROXY_CIDRS=
DOKKOMPLEKT_TRUSTED_PROXY_REQUIRE_X_FORWARDED_FOR=true

# Release signing machine / protected GitHub environment only; never embed or
# commit this private seed.
DOKKOMPLEKT_UPDATE_PRIVATE_KEY_B64=
