+fn validate_template_learning(input: &TemplateLearningInput) -> TemplateLearningValidation {
+    let pair_count = input.completed_examples.len();
+    let mut validation = TemplateLearningValidation::default();
+    if pair_count != input.source_examples.len() {
+        validation.reasons.push(format!(
+            "Для проверки нужны парные Source→Correct Output примеры: получено {} источников и {} правильных документов.",
+            input.source_examples.len(),
+            pair_count
+        ));
+        return validation;
+    }
+    if !(4..=10).contains(&pair_count) {
+        validation.reasons.push(
+            "Для publish-grade проверки нужны от 4 до 10 пар Source→Correct Output: минимум три пары для обучения и одна невиданная held-out пара."
+                .into(),
+        );
+        return validation;
+    }
+    if input
+        .completed_examples
+        .iter()
+        .chain(input.source_examples.iter())
+        .any(|text| text.trim().is_empty())
+    {
+        validation
+            .reasons
+            .push("Пустая сторона пары Source→Correct Output недопустима.".into());
+        return validation;
+    }
+
+    let held_out_index = pair_count - 1;
+    validation.training_pairs = held_out_index;
+    validation.held_out_pairs = 1;
+    let training_input = TemplateLearningInput {
+        blank_template_text: input.blank_template_text.clone(),
+        completed_examples: input.completed_examples[..held_out_index].to_vec(),
+        source_examples: input.source_examples[..held_out_index].to_vec(),
+        default_year: input.default_year,
+        locale: input.locale.clone(),
+    };
+    let trained = learn_template_from_examples_internal(&training_input);
+    if trained.fields.is_empty() {
+        validation.reasons.push(
+            "Обучающая часть пар не построила ни одного проверяемого поля; held-out проверка невозможна."
+                .into(),
+        );
+        return validation;
+    }
+
+    let training_source_maps = training_input
+        .source_examples
+        .iter()
+        .map(|text| semantic_value_map(text, input.default_year))
+        .collect::<Vec<_>>();
+    let held_out_source = semantic_value_map(&input.source_examples[held_out_index], input.default_year);
+    let wrong_source = &training_source_maps[0];
+    let held_out_output = &input.completed_examples[held_out_index];
+    let mut source_grounded_fields = 0usize;
+    let mut matched_fields = BTreeSet::new();
+    let mut mismatched_fields = BTreeSet::new();
+
+    for field in &trained.fields {
+        let mut observations = 0usize;
+        let mut grounded = true;
+        for (index, output) in training_input.completed_examples.iter().enumerate() {
+            let Some(output_value) = learned_field_value(output, field) else {
+                continue;
+            };
+            observations += 1;
+            let Some(expected) = training_source_maps[index].get(&field.field_id) else {
+                grounded = false;
+                break;
+            };
+            if !values_equivalent(&normalize_value(&output_value), expected) {
+                grounded = false;
+                break;
+            }
+        }
+        if !grounded || observations < 2 {
+            continue;
+        }
+        source_grounded_fields += 1;
+
+        let Some(output_value) = learned_field_value(held_out_output, field) else {
+            mismatched_fields.insert(field.field_id.clone());
+            continue;
+        };
+        let Some(expected) = held_out_source.get(&field.field_id) else {
+            mismatched_fields.insert(field.field_id.clone());
+            continue;
+        };
+        let normalized_output = normalize_value(&output_value);
+        if !values_equivalent(&normalized_output, expected) {
+            mismatched_fields.insert(field.field_id.clone());
+            continue;
+        }
+        matched_fields.insert(field.field_id.clone());
+
+        if let Some(intervention_value) = wrong_source.get(&field.field_id) {
+            if !values_equivalent(&normalize_value(expected), intervention_value)
+                && !values_equivalent(&normalized_output, intervention_value)
+            {
+                validation.interventions_checked += 1;
+            }
+        }
+    }
+
+    validation.matched_fields = matched_fields.into_iter().collect();
+    validation.mismatched_fields = mismatched_fields.into_iter().collect();
+    if source_grounded_fields == 0 {
+        validation.reasons.push(
+            "Не найдено полей, которые подтверждаются источником минимум в двух обучающих парах."
+                .into(),
+        );
+    }
+    if !validation.mismatched_fields.is_empty() {
+        validation.reasons.push(format!(
+            "Held-out документ не подтвердил поля: {}.",
+            validation.mismatched_fields.join(", ")
+        ));
+    }
+    if validation.matched_fields.is_empty() {
+        validation
+            .reasons
+            .push("Held-out пара не подтвердила ни одного source-grounded поля.".into());
+    }
+    if validation.interventions_checked == 0 {
+        validation.reasons.push(
+            "Intervention-проверка не доказала чувствительность карты к источнику: нужна пара, где подмена источника меняет хотя бы одно проверяемое поле."
+                .into(),
+        );
+    }
+    validation.passed = source_grounded_fields > 0
+        && validation.mismatched_fields.is_empty()
+        && !validation.matched_fields.is_empty()
+        && validation.interventions_checked > 0;
+    validation
+}
