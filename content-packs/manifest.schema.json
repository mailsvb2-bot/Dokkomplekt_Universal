{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dokkomplekt.local/schemas/content-pack-v1.json",
  "title": "Dokkomplekt optional content-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack_id",
    "version",
    "locale",
    "domain",
    "status",
    "publisher",
    "template_slots",
    "workflows"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "domain": {
      "enum": [
        "hr",
        "legal",
        "accounting",
        "medical",
        "education",
        "custom"
      ]
    },
    "status": {
      "enum": [
        "workflow_skeleton",
        "starter",
        "pilot",
        "approved"
      ]
    },
    "usage_mode": {
      "enum": [
        "draft_only",
        "production"
      ]
    },
    "requires_organization_review": {
      "type": "boolean"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "template_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "label",
          "required_fields",
          "referenced_fields",
          "template_path",
          "sha256"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "required_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
            },
            "uniqueItems": true
          },
          "template_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "referenced_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "event",
          "documents"
        ],
        "properties": {
          "workflow_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "review_note": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
