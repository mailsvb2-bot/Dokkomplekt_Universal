+        format!("processing_job_sha256={processing_job_sha256}"),
+        format!("source_sha256={source_sha256}"),
+        format!("processing_fingerprint={processing_fingerprint}"),
+    ];
+    required
+        .iter()
+        .all(|expected| body.lines().any(|line| line.trim() == expected))
+}
