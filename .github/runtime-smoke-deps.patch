     assert 'kill -TERM -- "-$pid"' in source
+
+
+def test_linux_packaging_workflows_install_every_rendered_smoke_command() -> None:
+    required_packages = ("xvfb", "dbus-x11", "x11-utils", "imagemagick")
+    for workflow_name in ("quality-gate.yml", "build-installers.yml"):
+        workflow = (ROOT / ".github" / "workflows" / workflow_name).read_text(encoding="utf-8")
+        for package in required_packages:
+            assert package in workflow, f"{workflow_name} does not install {package}"
+        assert "write_linux_appimage_runtime_manifest.py --bundle-dir" in workflow
