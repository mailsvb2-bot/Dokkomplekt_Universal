{
  "name": "dokkomplekt-universal-tauri",
  "version": "18.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:build:check": "tauri build --debug",
    "quality": "npm run typecheck && npm run test && npm run build && npm run test:python && python scripts/static_quality_gate.py --source-only",
    "clean": "node scripts/clean.mjs",
    "behavior": "vitest run --config vitest.config.ts src/App.test.tsx src/lib/api.test.ts",
    "parity": "python scripts/static_quality_gate.py --source-only",
    "prepackage": "bash scripts/prepackage_rust_gate.sh && python scripts/assert_release_ready.py",
    "release:assert": "python scripts/assert_release_ready.py",
    "test:python": "python scripts/run_python_contracts_sharded.py",
    "quality:release": "npm run quality && python scripts/static_quality_gate.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "@types/node": "^22.10.0"
  }
}
